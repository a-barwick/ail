module contracts;

record ReviewRequest {
  job_id: Text;
  task: Text;
  payload: Bytes;
  priority: PriorityOption;
  requested_by: Text;
  reviewer: Text;
}

record ApprovedJob {
  job_id: Text;
  task: Text;
  payload: Bytes;
  priority: Priority;
  requested_by: Text;
  reviewer: Text;
}

variant Priority {
  Low;
  Normal;
  High;
}

variant PriorityOption {
  Some(Priority);
  None;
}

variant ReviewReason {
  MissingJobId;
  InvalidJobId;
  MissingTask;
  TaskTooLong;
  TaskHasControl;
  PayloadTooLarge;
  MissingRequester;
  InvalidRequester;
  MissingReviewer;
  InvalidReviewer;
}

variant ValidationResult {
  Valid;
  Invalid(ReviewReason);
}

variant ReviewDecision {
  Approved(ApprovedJob);
  Rejected(ReviewReason);
}

fn preserve_request(request: ReviewRequest) -> ReviewRequest {
  request
}
