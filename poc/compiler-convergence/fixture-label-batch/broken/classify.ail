module classify;
import rules;
import types;

fn classify_one(request: types.LabelRequest) -> types.Label {
  if rules.is_blank(request) {
    types.Label::Empty
  } else {
    if rules.is_illegal(request.raw) {
      types.Label::Illegal
    } else {
      types.Label::Accepted(request.raw)
    }
  }
}
