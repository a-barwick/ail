module report;
import types;

fn note_for(label: types.Label) -> Text {
  "note"
}

fn report_one(label: types.Label) -> types.LabelReport {
  types.LabelReport { label: label, note: note_for(label) }
}

fn report_batch(labels: List<types.Label, 8>) -> List<types.LabelReport, 8> {
  map label in labels {
    report_one(label)
  }
}
