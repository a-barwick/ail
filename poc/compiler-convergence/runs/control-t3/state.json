  "published_sources": {
    "adapters.ail": "module adapters;\n\nfn marker(value: Text) -> Text {\n  value\n}\n",
    "contracts.ail": "module contracts;\n\nrecord CancelRequest {\n  value: Text;\n}\n\nvariant StoreOutcome {\n  Queued;\n  Running;\n  Missing;\n  Completed;\n  Cancelled;\n}\n\nvariant CancelOutcome {\n  Malformed;\n  Cancelled;\n  NotFound;\n  NotCancellable;\n}\n\nfn request_value(request: CancelRequest) -> Text {\n  request.value\n}\n",
    "domain.ail": "module domain;\nimport contracts;\n\nfn summarize(outcome: contracts.CancelOutcome) -> Text {\n  match outcome {\n    contracts.CancelOutcome::Malformed => {\n      \"malformed\"\n    },\n    contracts.CancelOutcome::Cancelled => {\n      \"cancelled\"\n    },\n    contracts.CancelOutcome::NotFound => {\n      \"not-found\"\n    },\n    contracts.CancelOutcome::NotCancellable => {\n      \"not-cancellable\"\n    },\n  }\n}\n",
    "tests.ail": "module tests;\nimport contracts;\nimport transport;\n\nfn cancel_case(value: Text, stored: contracts.StoreOutcome) -> contracts.CancelOutcome {\n  let request = contracts.CancelRequest { value: value };\n  transport.dispatch(request, stored)\n}\n",
    "transport.ail": "module transport;\nimport contracts;\n\nfn cancel_decision(stored: contracts.StoreOutcome) -> contracts.CancelOutcome {\n  match stored {\n    contracts.StoreOutcome::Queued => {\n      contracts.CancelOutcome::Cancelled\n    },\n    contracts.StoreOutcome::Running => {\n      contracts.CancelOutcome::Cancelled\n    },\n    contracts.StoreOutcome::Missing => {\n      contracts.CancelOutcome::NotFound\n    },\n    contracts.StoreOutcome::Completed => {\n      contracts.CancelOutcome::NotCancellable\n    },\n    contracts.StoreOutcome::Cancelled => {\n      contracts.CancelOutcome::NotCancellable\n    },\n  }\n}\n\nfn dispatch(request: contracts.CancelRequest, stored: contracts.StoreOutcome) -> contracts.CancelOutcome {\n  if text.is_empty(request.value) {\n    contracts.CancelOutcome::Malformed\n  } else {\n    if text.contains_control(request.value) {\n      contracts.CancelOutcome::Malformed\n    } else {\n      cancel_decision(stored)\n    }\n  }\n}\n"
  }
}
