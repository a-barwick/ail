    "contracts.ail": "module contracts;\n\nrecord CancelRequest {\n  value: Text;\n}\n\nvariant StoreOutcome {\n  Queued;\n  Running;\n  Missing;\n  Completed;\n  Cancelled;\n}\n\nvariant CancelOutcome {\n  Malformed;\n  Cancelled;\n  NotFound;\n  NotCancellable;\n}\n",
    "domain.ail": "module domain;\nimport contracts;\n\nfn summarize(outcome: contracts.CancelOutcome) -> Text {\n  match outcome {\n    contracts.CancelOutcome::Malformed => { \"malformed\" },\n    contracts.CancelOutcome::Cancelled => { \"cancelled\" },\n    contracts.CancelOutcome::NotFound => { \"not-found\" },\n    contracts.CancelOutcome::NotCancellable => { \"not-cancellable\" },\n  }\n}\n",
