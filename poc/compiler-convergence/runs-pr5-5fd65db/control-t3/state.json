  "published_sources": {
    "adapters.ail": "module adapters;\n\nfn marker(value: Text) -> Text {\n  value\n}\n",
    "contracts.ail": "module contracts;\n\nrecord CancelRequest {\n  value: Text;\n}\n\nvariant StoreOutcome {\n  Queued;\n  Running;\n  Missing;\n  Completed;\n  Cancelled;\n}\n\nvariant CancelOutcome {\n  Malformed;\n  Cancelled;\n  NotFound;\n  NotCancellable;\n}\n\nfn cancel_decision(stored: StoreOutcome) -> CancelOutcome {\n  match stored {\n    StoreOutcome::Queued => {\n      CancelOutcome::Cancelled\n    },\n    StoreOutcome::Running => {\n      CancelOutcome::Cancelled\n    },\n    StoreOutcome::Missing => {\n      CancelOutcome::NotFound\n    },\n    StoreOutcome::Completed => {\n      CancelOutcome::NotCancellable\n    },\n    StoreOutcome::Cancelled => {\n      CancelOutcome::NotCancellable\n    },\n  }\n}\n",
    "domain.ail": "module domain;\nimport contracts;\n\nfn summarize(outcome: contracts.CancelOutcome) -> Text {\n  match outcome {\n    contracts.CancelOutcome::Malformed => {\n      \"malformed\"\n    },\n    contracts.CancelOutcome::Cancelled => {\n      \"cancelled\"\n    },\n    contracts.CancelOutcome::NotFound => {\n      \"not-found\"\n    },\n    contracts.CancelOutcome::NotCancellable => {\n      \"not-cancellable\"\n    },\n  }\n}\n",
    "tests.ail": "module tests;\nimport contracts;\nimport transport;\n\nfn cancel_case(value: Text, stored: contracts.StoreOutcome) -> contracts.CancelOutcome {\n  let request = contracts.CancelRequest { value: value };\n  transport.dispatch(request, stored)\n}\n",
    "transport.ail": "module transport;\nimport contracts;\n\nfn dispatch(request: contracts.CancelRequest, stored: contracts.StoreOutcome) -> contracts.CancelOutcome {\n  if text.is_empty(request.value) {\n    contracts.CancelOutcome::Malformed\n  } else {\n    if text.contains_control(request.value) {\n      contracts.CancelOutcome::Malformed\n    } else {\n      contracts.cancel_decision(stored)\n    }\n  }\n}\n"
  }
}
